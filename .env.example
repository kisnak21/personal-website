# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Public site URL (used for SEO canonical/OG absolute URLs)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact Form URL (Formspree or similar) - used client-side
NEXT_PUBLIC_CONTACT_FORM_URL=your_formspree_url_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase Service Role Key - SERVER ONLY. Never expose to client bundle.
# Used by Route Handlers / Server Components for admin operations (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Session signing secret - SERVER ONLY. Used to sign the admin httpOnly cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_long_random_secret_here
